{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "teach-api-route": {
        "ClusterId": "teach-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "auth-api-route": {
        "ClusterId": "auth-api-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/auth/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "teach-api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "auth-api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "auth-destination1": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  }
}
